# Application
APP_ENV=development
API_HOST=127.0.0.1
API_PORT=8000
ANALYSIS_TIMEOUT_SECONDS=180
LOG_LEVEL=INFO

# KRX Open API: ETF daily trading information
KRX_API_KEY=
KRX_REQUEST_TIMEOUT_SECONDS=15
ETF_DATABASE_PATH=data/finance_analysis.db
# Public KODEX official constituent-PDF source (no API key required)
SAMSUNG_FUND_BASE_URL=https://www.samsungfund.com
SAMSUNG_FUND_REQUEST_TIMEOUT_SECONDS=15
# Quantitative calculation assumptions. Defaults are 3.0% KOFR and Friday (4).
KOFR_ANNUAL_RATE_PERCENT=3.0
# Monday=0 ... Friday=4. Friday holidays use the latest trading day in the same week.
WEEKLY_SAMPLE_WEEKDAY=4

# NAVER API HUB: News search (API Gateway key pair; never commit actual values)
NAVER_API_KEY_ID=
NAVER_API_KEY=
NAVER_NEWS_REQUEST_TIMEOUT_SECONDS=10
# TF-IDF cosine similarity minimum for ETF-news relevance validation.
NEWS_RELEVANCE_THRESHOLD=0.12

# Financial and news data providers (select concrete providers before implementation)
DART_API_KEY=your_dart_api_key_here

# OpenAI news sentiment analysis. Set a model explicitly for your account.
OPENAI_API_KEY=
OPENAI_SENTIMENT_MODEL=
OPENAI_REQUEST_TIMEOUT_SECONDS=30
# An ETF needs this many stored articles and LLM evidence article IDs to remain eligible.
SENTIMENT_MINIMUM_ARTICLES=2
# Independent ETF analyses run concurrently up to this limit.
SENTIMENT_MAX_PARALLEL_REQUESTS=4
